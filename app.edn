{:main ddc.server
 :target :nodejs
 :foreign-libs [{:file "node_modules/@std/http/unstable_route.js"
                 :provides ["@std/http/unstable-route"]
                 :module-type :es6}]
 :output-to "server.js"
 :output-dir "build"
 :optimizations :simple
 :pretty-print true
 :source-map "server.js.map"
 :infer-externs :all
 :language-in :es-next
 :language-out :es-next
 :dump-core true
 :stable-names true
 :optimize-constants true
 :parallel-build true
 :static-fns true
 :fn-invoke-direct true
 :aot-cache true
 :cache-analysis true}
